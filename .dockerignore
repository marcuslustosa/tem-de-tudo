# O Dockerfile faz `COPY backend ./`. Sem esta lista, tudo que estiver na pasta
# entra na imagem — inclusive um .env de desenvolvimento, que o Laravel carrega
# e que aponta para SQLite. Em uma build local isso sobe o app apontando para o
# banco errado sem nenhum aviso.
.git
.gitignore
.github

# Dependencias: sao reinstaladas dentro da imagem, com as versoes de producao.
**/node_modules
**/vendor

# Configuracao de ambiente: vem das variaveis do servico, nunca de arquivo.
**/.env
**/.env.*
!**/.env.example

# Banco local e artefatos de execucao.
**/*.sqlite
**/*.sqlite-journal
**/storage/logs/*
**/storage/framework/cache/data/*
**/storage/framework/sessions/*
**/storage/framework/views/*
**/bootstrap/cache/*.php

# Testes e ferramentas que nao vao para o servidor.
**/.phpunit.result.cache
**/coverage
**/.idea
**/.vscode
**/__proto/__screens

# Documentacao e capturas.
*.md
!README.md
